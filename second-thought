#!/usr/bin/env python3
"""Second Thought launcher — works from ANY folder (fixes 'No module named second_thought').

Use it instead of `python3 -m second_thought.cli ...`:
  1. Drag this file into a terminal window (macOS types the location for you).
  2. Add a space and a job, e.g.:  test   demo   setup
  3. Press Enter.
"""
import os
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)

from second_thought.cli import main

if __name__ == "__main__":
    sys.exit(main())
